{
  "uid": "fritz-logextractor",
  "title": "Fritz!LogExtractor",
  "description": "Whether fritz_logextractor keeps reading each device, and the events it read, with filters and search.",
  "tags": [
    "fritz",
    "fritz_logextractor",
    "logs"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Box reboots",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "changes(fritzlogextractor_box_reboots_total{device=~\"$device\"}[2m]) > 0",
        "step": "1m",
        "titleFormat": "Reboot of {{device}}",
        "textFormat": "The box restarted; its log starts afresh"
      }
    ]
  },
  "links": [
    {
      "title": "Documentation",
      "type": "link",
      "url": "https://pdreker.github.io/fritz_logextractor/",
      "targetBlank": true,
      "icon": "doc"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "stream",
        "label": "Loki streams",
        "type": "textbox",
        "query": "service_name=\"fritzlogextractor\"",
        "current": {
          "text": "service_name=\"fritzlogextractor\"",
          "value": "service_name=\"fritzlogextractor\""
        },
        "description": "Label matcher for the tool's lines in Loki, as your collector labels them",
        "hide": 0,
        "options": [
          {
            "selected": true,
            "text": "service_name=\"fritzlogextractor\"",
            "value": "service_name=\"fritzlogextractor\""
          }
        ]
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(fritzlogextractor_polls_total, device)",
        "query": {
          "query": "label_values(fritzlogextractor_polls_total, device)",
          "refId": "device"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "options": []
      },
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "definition": "label_values({${stream:raw}, kind=\"event\"}, group)",
        "query": {
          "type": 1,
          "label": "group",
          "stream": "{${stream:raw}, kind=\"event\"}",
          "refId": "group"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "options": []
      },
      {
        "name": "id",
        "label": "Message id",
        "type": "textbox",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        },
        "description": "Regular expression on the message id, e.g. 50[0-9]",
        "hide": 0,
        "options": [
          {
            "selected": true,
            "text": ".+",
            "value": ".+"
          }
        ]
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Text the message contains, any case",
        "hide": 0,
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ]
      },
      {
        "name": "level",
        "label": "Tool log level",
        "type": "custom",
        "query": "DEBUG,INFO,WARNING,ERROR,CRITICAL",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "WARNING",
            "ERROR",
            "CRITICAL"
          ],
          "value": [
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "options": [
          {
            "text": "DEBUG",
            "value": "DEBUG",
            "selected": false
          },
          {
            "text": "INFO",
            "value": "INFO",
            "selected": false
          },
          {
            "text": "WARNING",
            "value": "WARNING",
            "selected": true
          },
          {
            "text": "ERROR",
            "value": "ERROR",
            "selected": true
          },
          {
            "text": "CRITICAL",
            "value": "CRITICAL",
            "selected": true
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Status",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Last read",
      "description": "Time since the last poll that read the log and wrote its events.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - fritzlogextractor_last_success_timestamp_seconds{device=~\"$device\"}",
          "refId": "A",
          "legendFormat": "{{device}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 180
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "noValue": "-",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Polls OK",
      "description": "Share of successful polls in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - sum by (device) (increase(fritzlogextractor_poll_errors_total{device=~\"$device\"}[$__range])) / sum by (device) (increase(fritzlogextractor_polls_total{device=~\"$device\"}[$__range]))",
          "refId": "A",
          "legendFormat": "{{device}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "noValue": "-",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 3,
      "gridPos": {
        "x": 3,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Events",
      "description": "Event lines written in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum by (device) (increase(fritzlogextractor_events_total{device=~\"$device\"}[$__range])))",
          "refId": "A",
          "legendFormat": "{{device}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "-",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 4,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Rows on the box",
      "description": "Rows in the device's event log at the last poll. It drops old rows when full and empties on a reboot.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "fritzlogextractor_log_rows{device=~\"$device\"}",
          "refId": "A",
          "legendFormat": "{{device}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "-",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 5,
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 3,
        "h": 4
