    {
      "type": "table",
      "title": "Message ids",
      "description": "Event lines per message id in the selected time range. The id names the kind of message, whatever the box's language; filter on it above.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sort_desc(sum by (id) (count_over_time({${stream:raw}, kind=\"event\", device=~\"$device\", group=~\"$group\"} | json id=\"id\", msg=\"msg\", repeat=\"repeat\", time_estimated=\"time_estimated\" [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Lines"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Lines",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
