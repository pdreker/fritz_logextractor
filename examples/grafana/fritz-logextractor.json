      "type": "logs",
      "title": "Event log",
      "description": "The box's events, newest first: [group id] message (× repeats). Open a line for all its fields. Filter with Device, Group, Message id and Search above.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{${stream:raw}, kind=\"event\", device=~\"$device\", group=~\"$group\"} | json id=\"id\", msg=\"msg\", repeat=\"repeat\", time_estimated=\"time_estimated\" | id=~\"$id\" |~ `(?i)${search:regex}` | label_format level=\"info\" | line_format \"[{{.group}} {{.id}}] {{.msg}}{{ if ne .repeat \\\"1\\\" }} (×{{.repeat}}){{ end }}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
